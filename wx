local function walk()
	if RT.wc then RT.wc:Disconnect() RT.wc=nil end
	if RT.spd then RT.spd:Disconnect() RT.spd=nil end
	if RT.satt then pcall(function() RT.satt:Destroy() end) RT.satt=nil end
	local _,h=chr()
	if not h then return end
	if RT.wc0==nil then RT.wc0=h.WalkSpeed end
	local base=RT.wc0 or 16
	if S.SpOn then
		if S.SafeOn then
			-- [反检测伪装] WalkSpeed 钉死合法值，实际移动用帧步进
			h.WalkSpeed=base
			RT.spd=RS.RenderStepped:Connect(function()
				local _,hh,rr=chr()
				if not hh or not rr then return end
				hh.WalkSpeed=base
				local want=math.min(tonumber(S.SpV) or 50,S.SafeSpd)
				local dir=Vector3.new(hh.MoveDirection.X,0,hh.MoveDirection.Z)
				if dir.Magnitude<0.05 then local m=mv() dir=Vector3.new(m.X,0,m.Z) end
				if dir.Magnitude>0.05 then
				
					dir=dir.Unit
					rr.CFrame=rr.CFrame+dir*(want/60)
					local v=rr.AssemblyLinearVelocity
					rr.AssemblyLinearVelocity=Vector3.new(0,v.Y,0)
end
			end)
		else
			local v=tonumber(S.SpV) or 16
			h.WalkSpeed=v
			RT.wc=h:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
				local nv=tonumber(S.SpV) or 16
				if math.abs(h.WalkSpeed-nv)>0.1 then h.WalkSpeed=nv end
			end)
		end
