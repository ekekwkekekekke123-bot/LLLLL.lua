			local v=rr.AssemblyLinearVelocity
			if v.Y>1 then return end
			local jv=(S.JpOn and S.JpH or (RT.jp0 or 50))
			if S.SafeOn then jv=math.min(jv,S.SafeJump) end -- [反检测伪装] 垂直初速限幅
			rr.AssemblyLinearVelocity=Vector3.new(v.X,jv,v.Z)
		end)
	end
end
