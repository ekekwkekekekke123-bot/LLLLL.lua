	local ch=LP.Character
	local neck=ch and ch:FindFirstChild("Neck",true)
	if not S.TwOn or not neck then return end
	RT.twN=neck RT.twBase=neck.C0 RT.twA=0
	RT.twC=RS.Heartbeat:Connect(function(dt)
		local c=LP.Character
		local n=c and c:FindFirstChild("Neck",true)
		if not n then return end
		if n~=RT.twN then RT.twN=n RT.twBase=n.C0 return end
		RT.twA=RT.twA+dt
		local f=(math.floor(RT.twA*12)%2==0) and 1 or -1
