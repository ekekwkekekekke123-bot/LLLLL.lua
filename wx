local function nofly()
	if RT.fc then RT.fc:Disconnect() RT.fc=nil end
	if RT.dc then RT.dc:Disconnect() RT.dc=nil end
	if RT.bv then pcall(function() RT.bv:Destroy() end) RT.bv=nil end
	if RT.bg then pcall(function() RT.bg:Destroy() end) RT.bg=nil end
	if RT.fatt then pcall(function() RT.fatt:Destroy() end) RT.fatt=nil end
	local ch=RT.flyCh
	if not ch or not ch.Parent then ch=LP.Character end
	if ch and ch.Parent then
		local h=ch:FindFirstChildOfClass("Humanoid")
		if h then
			local an=ch:FindFirstChild("Animate") if an then an.Disabled=false end
			h.PlatformStand=false h.AutoRotate=true
			pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
			if h.Health>0 then h.WalkSpeed=RT.wc0 or 16 end
		end
		local r=ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
		if r then r.AssemblyLinearVelocity=Vector3.zero r.AssemblyAngularVelocity=Vector3.zero end
	end
	RT.flyCh=nil
end
local function fly()
	nofly()
	if not S.FlOn then return end
	local ch,h,r=chr() local cam=workspace.CurrentCamera
	if not h or not r or not cam then return end
	RT.flyCh=ch
	RT.dc=h.Died:Connect(function() pcall(nofly) end)
	local an=ch:FindFirstChild("Animate") if an then an.Disabled=true end
	h.PlatformStand=true h.AutoRotate=false h.WalkSpeed=0
	local phys=(S.FlMd=="物理")
	if phys then
		local bv=Instance.new("BodyVelocity")
		bv.Name="wxFlyBV" bv.MaxForce=Vector3.new(1e6,1e6,1e6) bv.Velocity=Vector3.zero bv.Parent=r
		local bg=Instance.new("BodyGyro")
		bg.Name="wxFlyBG" bg.MaxTorque=Vector3.new(1e6,1e6,1e6) bg.P=3000 bg.D=300 bg.CFrame=r.CFrame bg.Parent=r
		RT.bv=bv RT.bg=bg
	end
	RT.fc=RS.RenderStepped:Connect(function(dt)
		if LP.Character~=RT.flyCh or not RT.flyCh or not RT.flyCh.Parent then nofly() return end
		local c=workspace.CurrentCamera
		if not c then return end
		local hh=RT.flyCh:FindFirstChildOfClass("Humanoid")
		if not hh then return end
		hh.PlatformStand=true hh.WalkSpeed=0
		local spd=tonumber(S.FlV) or 35
		if S.SafeOn then spd=math.min(spd,S.SafeFlV or 18) end
				local m=mv()
		local look=c.CFrame.LookVector
		local move=look*(-m.Z)+c.CFrame.RightVector*m.X
		local vy=vv()

		local face=Vector3.new(move.X,0,move.Z)
		if face.Magnitude>0.05 then
			face=face.Unit
		else
			face=Vector3.new(look.X,0,look.Z)
			if face.Magnitude>0.05 then face=face.Unit else face=Vector3.new(0,0,-1) end
		end

		local dir=move
		if vy~=0 then dir=dir+Vector3.new(0,vy,0) end
		if dir.Magnitude>0.001 then dir=dir.Unit*spd else dir=Vector3.zero end

		if phys then
			if RT.bv and RT.bg then
				RT.bv.Velocity=dir
				RT.bg.CFrame=CFrame.lookAt(r.Position,r.Position+look)
			end
		else
			local np=r.Position+dir*dt
			r.CFrame=CFrame.lookAt(np,np+face)
			r.AssemblyLinearVelocity=Vector3.zero
			r.AssemblyAngularVelocity=Vector3.zero
		end
	end)
end
