			end
			pcall(function() TS:Create(hl,ti,{FillTransparency=1,OutlineTransparency=1}):Play() end)
			task.delay(st.dur+0.05,function()
				for i,v in ipairs(st.live) do if v==m then table.remove(st.live,i) break end end
				pcall(function() m:Destroy() end)
			end)
		end
		local function hit()
			if not st.on then return end
			local cam=workspace.CurrentCamera
			if not cam then return end
			local cx=cam.ViewportSize.X/2
			local cy=cam.ViewportSize.Y/2
			local best,bestD=nil,260
			for _,p in ipairs(P:GetPlayers()) do
				local c=p.Character
				if c and c~=LP.Character then
					local hum=c:FindFirstChildOfClass("Humanoid")
					local hrp=c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
					if hum and hum.Health>0 and hrp then
						local sp3,onS=cam:WorldToViewportPoint(hrp.Position)
						if onS then
							local d=(Vector2.new(sp3.X,sp3.Y)-Vector2.new(cx,cy)).Magnitude
							if d<bestD then bestD=d best=c end
						end
					end
				end
			end
			if not best then return end
			local t=os.clock()
			if st.last[best] and t-st.last[best]<0.4 then return end
			st.last[best]=t
			ghost(best)
		end
		local rp=RaycastParams.new()
		pcall(function() rp.FilterType=Enum.RaycastFilterType.Exclude end)
		local function drawTracer()
			local cam=workspace.CurrentCamera
			local ch=LP.Character
			if not cam or not ch then return end
			local org=cam.CFrame.Position
			local dir=cam.CFrame.LookVector
			rp.FilterDescendantsInstances={ch}
			local ok,res=pcall(function() return workspace:Raycast(org,dir*3000,rp) end)
			local fin=(ok and res and res.Position) or (org+dir*3000)
			local car=Instance.new("Part")
			car.Anchored=true car.CanCollide=false car.CanTouch=false car.CanQuery=false
			car.Transparency=1 car.Size=Vector3.new(0.1,0.1,0.1) car.CFrame=CFrame.new(org)
			car.Parent=workspace
			local a0=Instance.new("Attachment") a0.Parent=car a0.Position=Vector3.zero
			local a1=Instance.new("Attachment") a1.Parent=car a1.Position=fin-org
			local core=Instance.new("Beam")
			core.Attachment0=a0 core.Attachment1=a1
			core.Width0=0.05 core.Width1=0.02
			core.Color=ColorSequence.new(tr.col)
			core.LightInfluence=0 core.FaceCamera=true
			core.Transparency=NumberSequence.new(0)
			core.Parent=car
			local glow=Instance.new("Beam")
			glow.Attachment0=a0 glow.Attachment1=a1
			glow.Width0=0.44 glow.Width1=0.18
			glow.Color=ColorSequence.new(tr.col)
			glow.LightInfluence=0 glow.FaceCamera=true
			glow.Transparency=NumberSequence.new(0.82)
			glow.Parent=car
			local ti=TweenInfo.new(0.35,Enum.EasingStyle.Linear)
			pcall(function()
				TS:Create(core,ti,{Transparency=NumberSequence.new(1)}):Play()
				TS:Create(glow,ti,{Transparency=NumberSequence.new(1)}):Play()
			end)
			task.delay(0.4,function() pcall(function() car:Destroy() end) end)
		end
		local holding=false
		local cd=0
		UI.InputBegan:Connect(function(i,g)
			if g then return end
			if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
				holding=true
				local now=os.clock()
				if now-cd<0.05 then return end
				cd=now
				if tr.on then drawTracer() end
				hit()
			end
		end)
		UI.InputEnded:Connect(function(i)
			if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then holding=false end
		end)
		task.spawn(function()
			while true do
				task.wait(0.07)
				if holding and tr.on then drawTracer() end
			end
		end)
		workspace.DescendantAdded:Connect(function(o)
			if not tr.on then return end
			local nm=string.lower(o.Name)
			if o:IsA("MeshPart") and (string.find(nm,"bullet") or string.find(nm,"trac")) then
				pcall(function()
					o.Color=tr.col
					o.Material=Enum.Material.Neon
					o.Reflectance=0
					o.TextureID=""
				end)
			elseif o:IsA("Trail") then
				pcall(function()
					o.Color=ColorSequence.new(tr.col)
					o.LightEmission=0
					o.WidthScale=NumberSequence.new(1.8)
					o.Lifetime=0.5
				end)
			elseif o:IsA("Beam") then
				pcall(function()
					o.Color=ColorSequence.new(tr.col)
					o.LightInfluence=0
					if o.Width0<0.06 then o.Width0=0.08 end
				end)
			end
		end)
		local b1,t1,k1=rowT("击中残影（不完全通用）",1)
		b1.MouseButton1Click:Connect(function()
			st.on=not st.on flip(t1,k1,st.on)
			if not st.on then for i=#st.live,1,-1 do pcall(function() st.live[i]:Destroy() end) st.live[i]=nil end end
		end)
		local c1,blk1=rowC("修改残影颜色",2,st.col)
		ghBlk=blk1
		c1.MouseButton1Click:Connect(function() openCp("ghost") end)
		local b2,t2,k2=rowT("子弹轨迹（不完全通用）",3)
		b2.MouseButton1Click:Connect(function()
			tr.on=not tr.on flip(t2,k2,tr.on)
			if not tr.on then holding=false end
		end)
		local c2,blk2=rowC("修改子弹轨迹颜色",4,tr.col)
		trBlk=blk2
		c2.MouseButton1Click:Connect(function() openCp("tracer") end)
	else
		warn("[WX] 美化页找不到")
	end
end
