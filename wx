local function pick(cam,cx,cy)
	local best,bv=nil,nil
	local hunt=(S.NameHunt and #NL>0)
	local targets={}
	if S.AiType=="玩家" or S.AiType=="全部" then
		for _,p in ipairs(P:GetPlayers()) do if p~=LP then targets[#targets+1]={ch=p.Character,name=p.Name,team=p.Team,plr=p} end end
	end
	if S.AiType=="NPC" or S.AiType=="全部" then
		for _,m in ipairs(workspace:GetChildren()) do
			if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") and not P:GetPlayerFromCharacter(m) then targets[#targets+1]={ch=m,name=m.Name,plr=nil} end
		end
	end
	for _,t in ipairs(targets) do
		local ch=t.ch
		if ch then
			local hu=ch:FindFirstChildOfClass("Humanoid")
			local ok=true
			if S.AiTeam and t.plr and t.team==LP.Team then ok=false end
			if S.Lock~="无" and t.name~=S.Lock then ok=false end
			if hunt then local f=false for _,n in ipairs(NL) do if t.name==n then f=true end end if not f then ok=false end end
			if ok and hu and hu.Health>0 then
				local part=ch:FindFirstChild(S.AiPart) or ch:FindFirstChild("HumanoidRootPart")
				if part then
					local d=(cam.CFrame.Position-part.Position).Magnitude
					local sp,on=cam:WorldToViewportPoint(part.Position)
					local ang=(Vector2.new(sp.X,sp.Y)-Vector2.new(cx,cy)).Magnitude
					if (on or S.AiWall) and d<=S.AiMax and ((S.Lock~="无") or (not S.FovFixed) or ang<=S.FovR) then
						local v=ang
						if S.AiPrio=="距离最近" then v=d elseif S.AiPrio=="血量最少" then v=hu.Health end
						if bv==nil or v<bv then best=t bv=v end
					end
				end
			end
		end
	end
	return best
end
