	local hu=ch:FindFirstChildOfClass("Humanoid")
	local hd=ch:FindFirstChild("Head") local rt=ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
	if not hu or hu.Health<=0 or not hd or not rt then
		local d=DD[p]
			if d.hl then d.hl:Destroy() d.hl=nil end
		return
	end
	local d=DD[p]
	if not d or d.ch~=ch then
		if d then drop(p) end
		mk(p) d=DD[p]
		if not d then return end
	end
