		h.WalkSpeed=base
	end
end
local function jump()
	local _,h=chr()
	if RT.jc then RT.jc:Disconnect() RT.jc=nil end
	if RT.jl then RT.jl:Disconnect() RT.jl=nil end
	if not h then return end
	if RT.jp0==nil then RT.jp0=h.JumpPower RT.jh0=h.JumpHeight RT.ujp=h.UseJumpPower end
	if S.JpOn then
		if S.SafeOn then
			-- [反检测伪装] JumpPower 保持默认值，不暴露属性改动
			h.UseJumpPower=RT.ujp h.JumpPower=RT.jp0
			pcall(function() h.JumpHeight=RT.jh0 or 7.2 end)
		else
			h.UseJumpPower=true h.JumpPower=S.JpH
			pcall(function() h.JumpHeight=S.JpH*0.5 end)
		end
	else
		h.UseJumpPower=RT.ujp h.JumpPower=RT.jp0
		pcall(function() h.JumpHeight=RT.jh0 or 7.2 end)
	end
	if S.JpInf then
		RT.jc=UI.JumpRequest:Connect(function() RT.jf=os.clock() end)
		RT.jl=RS.Heartbeat:Connect(function(dt)
			local _,hh,rr=chr()
